{
  "name": "hearthstone-theme",
  "displayName": "Hearthstone",
  "description": "Dark theme. Warm charcoal base, earthy syntax palette — orange, mauve, sage, steel, and rose.",
  "version": "0.1.0",
  "publisher": "jackson-hughes",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackson-hughes/hearthstone-theme"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Hearthstone",
        "uiTheme": "vs-dark",
        "path": "./themes/hearthstone-color-theme.json"
      }
    ]
  },
  "scripts": {
    "package": "vsce package --skip-license",
    "install-extension": "code --install-extension hearthstone-theme-0.1.0.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.7.1"
  }
}
